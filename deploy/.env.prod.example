# 复制为 .env.prod 并填写

# ===== LLM（OpenAI 兼容，主配置） =====
# P3 微调模型接入时：LLM_BASE_URL 填 vLLM 地址（如 http://内网IP:8100/v1），LLM_MODEL 填 vLLM 上模型名（端口约定见 P3 文档 §10.1）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== LLM 遗留别名(deprecated) =====
# 老配置仍兼容；新部署一律用上面 LLM_*，未填才回退到 DEEPSEEK_*
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Embedding =====
# 容器内默认 hash（免下载模型）；有 GPU/网络可改为本地 sentence-transformers 名（BAAI/bge-m3）
EMBEDDING_MODEL=hash
# 远程 BGE-M3（P3 GPU 服务，生产推荐开启）：非空则向量化走 POST {url}/v1/embeddings（取 dense），EMBEDDING_MODEL 忽略
# 切换向量实现后需删容器卷内 data/vectors 并重新导入
# 端口约定（P3 文档 §10.1）：如 http://内网IP:8200
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# ===== Reranker（可选，默认关闭；P3 生产推荐开启） =====
# 远程 BGE-reranker（P3 GPU 服务）：非空则问答阶段启用重排，POST {url}/v1/rerank（sentence_pairs）
# 端口约定（P3 文档 §10.1）：如 http://内网IP:8300
RERANK_API_URL=
RERANK_API_KEY=
RERANK_TOP=20

# ===== 检索参数 =====
# 单路召回量 = TOP_K * RECALL_MULTIPLIER（多路 RRF 融合前各自召回这么多候选）
TOP_K=5
RRF_K=60
# 混合检索权重（BM25 与向量分融合，和应≈1）
W_BM25=0.4
W_VEC=0.6
RECALL_MULTIPLIER=2
# MMR 去冗余：同源/相近文档只留最具代表性的，避免同文档多段挤占 top_k
MMR_ENABLED=false
MMR_LAMBDA=0.7
MMR_TOP=5

# ===== P0 安全 =====
# 会话有效期（秒）
SESSION_TTL_SECONDS=7200
# 生产域名（list 用 JSON 传）
CORS_ORIGINS=["https://example.com"]
# 上传文件大小上限（MB）与导入文本长度上限（字符）
MAX_UPLOAD_SIZE_MB=50
MAX_TEXT_CHARS=200000
# 生产关闭 /docs；置于 TLS 反向代理后启用 HSTS
ENABLE_DOCS=false
FORCE_HTTPS_HEADERS=true
